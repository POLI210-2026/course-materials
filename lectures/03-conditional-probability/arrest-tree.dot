digraph arrest {
  graph [rankdir=LR, bgcolor="transparent", ranksep=0.85, nodesep=0.42, ordering=out, pad=0.15];
  node [shape=plaintext, fontname="Arial", fontsize=22, fontcolor="#172d42"];
  edge [fontname="Arial", fontsize=20, color="#667887", fontcolor="#172d42", arrowsize=0.65];
  start [label="Stopped\npopulation"];
  guilty [label="G\nGuilty"];
  innocent [label="Gᶜ\nInnocent"];
  ga [label="Arrested (A)\n0.15 × 0.90 = 0.135", fontcolor="#005a8b"];
  gn [label="Not arrested (Aᶜ)\n0.15 × 0.10 = 0.015"];
  ia [label="Arrested (A)\n0.85 × 0.20 = 0.170", fontcolor="#005a8b"];
  in [label="Not arrested (Aᶜ)\n0.85 × 0.80 = 0.680"];
  start -> guilty [label="0.15"];
  start -> innocent [label="0.85"];
  guilty -> ga [label="0.90", color="#005a8b", penwidth=2];
  guilty -> gn [label="0.10"];
  innocent -> ia [label="0.20", color="#005a8b", penwidth=2];
  innocent -> in [label="0.80"];
}
